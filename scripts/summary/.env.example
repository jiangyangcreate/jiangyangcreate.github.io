# 复制本文件为 .env 并填写密钥（.env 已被 gitignore，不会入库）

# 文本模型（生成摘要与播客对谈台词必填；OpenAI 兼容接口）
# DeepSeek：https://api.deepseek.com（也兼容 https://api.deepseek.com/v1），模型 deepseek-chat / deepseek-reasoner
TEXT_API_KEY=
TEXT_BASE_URL=https://api.deepseek.com
TEXT_MODEL=deepseek-v4-flash

# 对谈台词模型（可选）：默认沿用 TEXT_MODEL；想分开控成本可单独配
# TEXT_DIALOGUE_MODEL=deepseek-chat

# 播客 TTS（OpenAI audio/speech；台词脚本由上方 TEXT_* 生成，男/女分轨合成后按序拼接）
# 缺失 TTS_API_KEY 时跳过播客，仅生成文字摘要
TTS_API_KEY=
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=tts-1
TTS_VOICE_MALE=onyx
TTS_VOICE_FEMALE=nova

# 片头音乐（可选）：整段 mp3 直接二进制拼接到语音最前
# 不填则默认读取 scripts/summary/intro.mp3，文件不存在时本次不带片头
# TTS_INTRO_MUSIC=

# 可选覆盖（不填则使用默认值）
# SITE_URL=https://jiangmiemie.com
# BLOG_RSS=<仓库根>/build/blog/rss.xml
# SUMMARY_DIR=<仓库根>/static/blog/summary
