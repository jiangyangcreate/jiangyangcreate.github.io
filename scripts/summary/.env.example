# 复制本文件为 .env 并填写密钥（.env 已被 gitignore，不会入库）

# 文本模型（生成摘要必填；OpenAI 兼容接口）
TEXT_API_KEY=
TEXT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TEXT_MODEL=qwen3.5-plus-2026-04-20

# 播客 TTS（字节火山 SAMI；缺失时跳过播客，仅生成文字摘要）
PODCAST_BASE_URL=wss://openspeech.bytedance.com/api/v3/sami/podcasttts
PODCAST_APPID=
PODCAST_ACCESS_TOKEN=
PODCAST_APP_KEY=
PODCAST_RESOURCE_ID=volc.service_type.10050

# 可选覆盖（不填则使用默认值）
# SITE_URL=https://jiangmiemie.com
# BLOG_RSS=<仓库根>/build/blog/rss.xml
# SUMMARY_DIR=<仓库根>/static/blog/summary
